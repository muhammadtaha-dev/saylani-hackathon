# HCM Lite — backend environment variables.
# Copy to .env.local for local development, or set these in your Vercel
# project settings. Never commit real keys (`.env*` is git-ignored).

# Google Gemini API key. When absent, the assistant automatically runs in
# "grounded mock" mode: a deterministic planner answers from the same tool
# executor and permission layer, so every acceptance behaviour still works
# with zero provider access.
# GEMINI_API_KEY is read first, then AI_API_KEY (Constitution Art. III.1).
GEMINI_API_KEY=
AI_API_KEY=

# HMAC secret that signs the demo session cookie. Any random string; the
# default is fine for local demos, set a unique value in production.
SESSION_SECRET=
