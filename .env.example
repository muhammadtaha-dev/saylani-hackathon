# HCM Lite — backend environment variables.
# Copy to .env.local for local development, or set these in your Vercel
# project settings. Never commit real keys (`.env*` is git-ignored).

# Google Gemini API key. When absent, the assistant automatically runs in
# "grounded mock" mode: a deterministic planner answers from the same tool
# executor and permission layer, so every acceptance behaviour still works
# with zero provider access.
# GEMINI_API_KEY is read first, then AI_API_KEY (Constitution Art. III.1).
# SECURITY: there is no fallback key in the source — if no env key is set the
# app runs the mock. Rotate any key that was ever committed to a repository.
GEMINI_API_KEY=
AI_API_KEY=

# HMAC secret that signs the session cookie. REQUIRED for stable sessions in
# production: without it the app generates a random per-process secret, so
# sessions stay secure but do not survive restarts/cold starts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional overrides (advanced):
#   HCM_STATE_DIR — directory for persisted deltas + the audit trail
#                   (default ./.data; on Vercel state and audit are per-instance)
#   AUDIT_FILE    — explicit path of the append-only audit JSONL
